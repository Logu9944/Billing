{
  "appId": "com.levroun.finbilling",
  "appName": "Levroun FinBilling",
  "webDir": "public",
  "bundledWebRuntime": false,
  "server": {
    "url": "http://localhost:3000",
    "cleartext": true
  },
  "android": {
    "allowMixedContent": true,
    "backgroundColor": "#102A43"
  },
  "plugins": {
    "SplashScreen": {
      "launchShowDuration": 1500,
      "backgroundColor": "#102A43",
      "showSpinner": false
    }
  }
}
